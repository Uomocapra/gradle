# Post-build hook: stores every populated integration-test Gradle user home
# (intTestHomeDir/distributions-*) to the Develocity artifact cache for later builds to restore.

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=common.sh
source "${SCRIPT_DIR}/common.sh"

setUpArtifactCache || exit 0

if [ ! -d "${INT_TEST_HOME_DIR}" ]; then
  echo "No integration-test Gradle user home at ${INT_TEST_HOME_DIR} - nothing to store."
  exit 0
fi

storeDistribution() {
  local gradleHome="$1"
  local dist
  dist="$(basename "${gradleHome}")"          # e.g. distributions-full
  dist="${dist#distributions-}"               # -> full
  local imageName
  imageName="$(imageNameFor "${dist}")"

  echo "Storing integration-test Gradle user home '${gradleHome}' to image '${imageName}'..."
  local start_time
  start_time="$(date +%s)000"

  # Do not fail the build if a store errors.
  set +e
  "${AC_CLI_JAVA}" -jar "${AC_CLI_JAR}" \
    store \
    --dv-edge="${DEVELOCITY_SERVER_URL}" \
    --image-name="${imageName}" \
    --gradle-home="${gradleHome}" \
    --reporting-directory="build/artifact-cache-report/store/distributions-${dist}" \
    --cache-metrics-file="build/artifact-cache-metrics/store-distributions-${dist}.json" \
    --operation-timeout=PT10M \
    --verbose
  local exitCode=$?
  set -e

  local end_time
  end_time="$(date +%s)000"
  echo "Storing '${gradleHome}' finished in $((end_time - start_time)) ms with exit code ${exitCode}."
}

shopt -s nullglob
for gradleHome in "${INT_TEST_HOME_DIR}"/distributions-*/; do
  # Only store homes that actually have a dependency cache.
  if [ -d "${gradleHome}caches/modules-2" ]; then
    storeDistribution "${gradleHome%/}"
  fi
done
